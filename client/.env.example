# Copy to client/.env.local and adjust. Never commit the real file.
#
# Only variables prefixed VITE_ reach the browser — Vite refuses to expose the
# rest, which is the whole point of the prefix. Nothing secret belongs here:
# every value in this file ships inside the JS bundle.

# ── API ──────────────────────────────────────────────────────────────────────
# The server's base path is /api/v1 (MVP.md §7). Include it — client.js appends
# only the route, e.g. api.get('/health') → http://localhost:3000/api/v1/health.
# Production: the Render URL from PR 0.9.
VITE_API_URL="http://localhost:3000/api/v1"
