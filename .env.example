# Copy to .env AT THE REPO ROOT and fill in. Never commit the real file.
# Deployment notes, including which of these the deployed services need and
# where each one is set: docs/DEPLOYMENT.md.
#
# One file for the whole monorepo. Server, Vite and the Prisma CLI all read this
# one — server/ and client/ have no .env of their own. Both server and client are
# started from the root via npm workspaces, and the server resolves this path from
# its own location rather than from cwd, so it does not matter where you run from.
#
# Vite only exposes variables prefixed VITE_ to the browser bundle. That prefix is
# what keeps the secrets below out of the client, and it is the reason one shared
# file is safe: a key without the prefix cannot reach the browser even by accident.
#
# Variables marked (E3) (E5) (E6) are only needed once that epic starts —
# the server boots without them in development. In production they are required.

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── database ─────────────────────────────────────────────────────────────────
# Local: `npm run db:up` starts Postgres 16 on port 5433 (not 5432 — see
# docker-compose.yml).
#
# Production: the Neon connection string, set in the Render dashboard (never
# here — this file is the example, and .env is gitignored and never uploaded).
# Neon hands out two strings for the same database and they are one character
# apart:
#
#   direct  postgresql://…@ep-xxx.eu-central-1.aws.neon.tech/tutor_now?sslmode=require
#   pooled  postgresql://…@ep-xxx-pooler.eu-central-1.aws.neon.tech/…
#
# Use the DIRECT one. `prisma migrate deploy` takes advisory locks that
# PgBouncer's transaction mode does not hold across statements, so the pooled
# string turns a deploy into a hang or `prepared statement "s0" already exists`.
# One free Render instance does not open enough connections to need pooling.
# docs/DEPLOYMENT.md § "Pooled vs direct" has the upgrade path for when it does.
#
# `?sslmode=require` is not optional on Neon — it rejects plaintext.
DATABASE_URL="postgresql://tutor:tutor@localhost:5433/tutor_now?schema=public"

# ── auth (PR 1.1) ────────────────────────────────────────────────────────────
# Two different secrets, 32+ chars each. A leaked access secret must not be able
# to mint refresh tokens. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated, exact origins, no wildcards and no trailing slash — env.js
# splits on commas and app.js does an exact `includes` against the list.
#
# Production (Render dashboard) is the Vercel production origin:
#   CORS_ORIGINS="https://tutor-now.vercel.app"
#
# Preview deployments each get their own origin, so they are added one at a
# time as branches come up. Do not "solve" it with a regex on .vercel.app —
# anyone can deploy a project on that domain. docs/DEPLOYMENT.md § "CORS".
CORS_ORIGINS="http://localhost:5173"

# ── Cloudinary (E3) — question images and teacher documents ──────────────────
# cloudinary.com → Dashboard → Product Environment Credentials
#
# Optional locally, MANDATORY in production: `requiredInProduction` in
# server/src/config/env.js exits the process on boot if these are missing when
# NODE_ENV=production. So the free Cloudinary account has to exist before the
# first Render deploy can boot, even though E3 has not started.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Anthropic (E3) — question classification and the entrance exam bank ──────
# console.anthropic.com → API keys
# Same as Cloudinary above: optional locally, required for the server to boot
# in production.
ANTHROPIC_API_KEY=""

# ── Zoom (E6) — Server-to-Server OAuth app ───────────────────────────────────
# marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ── Email (E5) — offer notifications to teachers ─────────────────────────────
# resend.com → API Keys. EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="TutorNow <noreply@example.com>"

# ── client (VITE_ prefix = shipped in the browser bundle) ────────────────────
# Nothing secret goes below this line. Every value here is readable by anyone
# who opens devtools.
#
# The server's base path is /api/v1 (MVP.md §7). Include it — client.js appends
# only the route, e.g. api.get('/health') → http://localhost:3000/api/v1/health.
# Production: the Render URL from PR 0.9.
#
# This file never reaches Vercel. The Vercel project's root directory is client/,
# so the repo-root .env sits outside it, and .env is gitignored regardless. The
# deployed value is set in the Vercel dashboard once per environment — Production
# and Preview get different ones. See docs/DEPLOYMENT.md § "Environment variables".
VITE_API_URL="http://localhost:3000/api/v1"
