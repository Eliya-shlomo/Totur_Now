# Copy to server/.env and fill in. Never commit the real file.
# Full deployment notes land in PR 0.9 (docs/DEPLOYMENT.md).
#
# Variables marked (E3) (E5) (E6) are only needed once that epic starts —
# the server boots without them in development. In production they are required.

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── database ─────────────────────────────────────────────────────────────────
# Local: `npm run db:up` starts Postgres 16 on port 5433 (not 5432 — see
# docker-compose.yml). Production: the Neon connection string.
DATABASE_URL="postgresql://tutor:tutor@localhost:5433/tutor_now?schema=public"

# ── auth (PR 1.1) ────────────────────────────────────────────────────────────
# Two different secrets, 32+ chars each. A leaked access secret must not be able
# to mint refresh tokens. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Add the Vercel production and preview origins in production.
CORS_ORIGINS="http://localhost:5173"

# ── Cloudinary (E3) — question images and teacher documents ──────────────────
# cloudinary.com → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Anthropic (E3) — question classification and the entrance exam bank ──────
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=""

# ── Zoom (E6) — Server-to-Server OAuth app ───────────────────────────────────
# marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ── Email (E5) — offer notifications to teachers ─────────────────────────────
# resend.com → API Keys. EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="TutorNow <noreply@example.com>"
