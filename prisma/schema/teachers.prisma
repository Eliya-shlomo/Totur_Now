// Domain: teachers and the topic taxonomy. Source of truth is MVP.md §11.2,
// "TEACHERS". Topics live here rather than in their own file per OWNERSHIP.md
// §3.1 — they exist to be taught, and every write to them is a teacher write.

enum TeacherStatus {
  OFFLINE
  ONLINE
  OFFER_LOCKED
  IN_SESSION

  @@map("teacher_status")
}

// No TeacherBadge or PriceTier enum. Both were dropped on the 8/11 revision:
// standing (MVP.md §6.2) is computed from sessionsCount and the rating columns,
// and the price band (§5.2) is computed from pricePerBlock. Storing either would
// be a second copy of a number we already have, free to drift from the first.

model TeacherProfile {
  userId String @id @map("user_id") @db.Uuid
  bio    String?

  // The teacher sets this themselves, MVP.md §5.2. The 5–20 range is enforced by
  // a CHECK constraint in the migration as well as by the Zod validator — the
  // database is the last line, because a bad price corrupts every later charge.
  pricePerBlock Int @default(10) @map("price_per_block")

  status           TeacherStatus @default(OFFLINE)
  levelMax         Int           @default(3) @map("level_max") @db.SmallInt // self-declared, §6.1
  zoomPersonalLink String?       @map("zoom_personal_link")

  // Denormalized aggregates for performance. Every one of them is maintained by
  // a service, never by a controller.
  sessionsCount  Int       @default(0) @map("sessions_count")
  resolvedCount  Int       @default(0) @map("resolved_count")
  offersReceived Int       @default(0) @map("offers_received")
  offersAccepted Int       @default(0) @map("offers_accepted")
  ratingSum      Int       @default(0) @map("rating_sum")
  ratingCount    Int       @default(0) @map("rating_count")
  noShowCount    Int       @default(0) @map("no_show_count")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics     TeacherTopic[]
  topicStats TeacherTopicStat[]

  // NOTE: idx_teacher_available — `(status, level_max, price_per_block) WHERE
  // status = 'ONLINE'`, the index the matching hard filter runs on (MVP.md §9.1)
  // — is deliberately NOT declared here. Prisma cannot express a partial index,
  // and declaring the full one instead makes every future `migrate dev` emit a
  // CREATE INDEX for a name that already exists. It lives only in the migrations.
  @@map("teacher_profiles")
}

model Topic {
  id       Int    @id @default(autoincrement())
  parentId Int?   @map("parent_id") // NULL = parent topic
  nameHe   String @map("name_he") @db.VarChar(80)
  nameEn   String @map("name_en") @db.VarChar(80)
  slug     String @unique @db.VarChar(80)

  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Topic[] @relation("TopicHierarchy")

  teacherTopics       TeacherTopic[]
  teacherTopicStats   TeacherTopicStat[]
  questionsAsTopic    Question[]         @relation("QuestionTopic")
  questionsAsSubtopic Question[]         @relation("QuestionSubtopic")

  @@map("topics")
}

model TeacherTopic {
  teacherId String @map("teacher_id") @db.Uuid
  topicId   Int    @map("topic_id")

  teacher TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([teacherId, topicId])
  @@map("teacher_topics")
}

model TeacherTopicStat {
  teacherId String @map("teacher_id") @db.Uuid
  topicId   Int    @map("topic_id")

  // NUMERIC(8,2), not INTEGER. A session on a subtopic propagates to its parent
  // topic at weight 0.3 (MVP.md §9.3); integer columns would truncate that to
  // zero and the Bayesian smoothing would silently never see parent history.
  ratingSum     Decimal @default(0) @map("rating_sum") @db.Decimal(8, 2)
  ratingCount   Decimal @default(0) @map("rating_count") @db.Decimal(8, 2)
  resolvedCount Decimal @default(0) @map("resolved_count") @db.Decimal(8, 2)
  sessionsCount Decimal @default(0) @map("sessions_count") @db.Decimal(8, 2)

  teacher TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  topic   Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([teacherId, topicId])
  @@map("teacher_topic_stats")
}

// TeacherDocument lived here until the 8/11 revision. Document upload, the admin
// approval queue and academic email verification are out of MVP — see MVP.md §6.1
// for why, and §21 for the shape they take when they come back.
