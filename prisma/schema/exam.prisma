// Domain: the teacher entrance exam. Source of truth is MVP.md §11.2,
// "ENTRANCE EXAM". Stage 0 of verification (MVP.md §6.1) — mandatory for every
// teacher before they can go ONLINE.

model EntranceQuestion {
  id      Int  @id @default(autoincrement())
  level   Int? @db.SmallInt
  topicId Int? @map("topic_id")
  body    String

  // Four answer strings, generated by LLM call 2 (MVP.md §8.2). JSONB rather
  // than a child table: the bank is written once and only ever read whole.
  options      Json
  correctIndex Int  @map("correct_index") @db.SmallInt

  topic Topic? @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@map("entrance_questions")
}

model EntranceAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String?  @map("teacher_id") @db.Uuid
  score     Int?     @db.SmallInt
  answers   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@map("entrance_attempts")
}
